{% from 'docker/docker.map.jinja' import DOCKER -%}
{
  "registry-mirrors": [
    "https://:5000"
  ],
  "bip": "172.17.0.1/24",
  "default-address-pools": [
    {
      "base": "172.17.0.0/24",
      "size": 24
    }
  ]
{%- if DOCKER.default_ulimits %},
  "default-ulimits": {
{%-   for ULIMIT in DOCKER.default_ulimits %}
    "{{ ULIMIT.name }}": {
      "Name": "{{ ULIMIT.name }}",
      "Soft": {{ ULIMIT.soft }},
      "Hard": {{ ULIMIT.hard }}
    }{{ "," if not loop.last else "" }}
{%-   endfor %}
  }
{%- endif %}
}
