beacons:
  inotify:
    - disable_during_state_run: True
    - coalesce: True
    - files:
        /opt/so/saltstack/local/salt/suricata/rules/:
          mask:
            - close_write
            - moved_to
            - delete
          recurse: True
          auto_add: True
        /opt/so/saltstack/local/salt/strelka/rules/compiled/:
          mask:
            - close_write
            - moved_to
            - delete
          recurse: True
          auto_add: True
        /opt/so/saltstack/local/pillar/:
          mask:
            - close_write
            - moved_to
            - delete
          recurse: True
          auto_add: True
